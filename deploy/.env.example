# Copy to deploy/.env (gitignored) to override defaults. Nothing here is
# required - every value below is the default the compose file uses.
#
# Compose reads STUDIO_* from the shell or from a root .env; to use this
# file for them, run compose with:  docker compose --env-file deploy/.env ...
# ANPR_* lines are passed to the backend container as-is.

# Host directories (bind mounts). Both on the one disk this server has,
# which it shares with MLFF's MySQL - watch it with `df -h /app`.
STUDIO_DATA_DIR=/app/studio/data
STUDIO_INCOMING_DIR=/app/studio/incoming

# Host port for http://<server-ip>:<port>/, loopback, and MLFF's proxy.
# Changing it also means changing deploy/mlff/studio-proxy.inc.
STUDIO_HTTP_PORT=8090

# The backend runs as this host user, so its files stay manageable.
STUDIO_UID=1000
STUDIO_GID=1000

# Backend settings (see backend/app/core/config.py).
ANPR_DEVICE=auto
ANPR_LOG_LEVEL=INFO
