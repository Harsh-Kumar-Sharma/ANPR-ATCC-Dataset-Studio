# Shape only. The real file is deploy/.htpasswd, generated ON THE SERVER
# and never committed (it is gitignored). One user per line, bcrypt:
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB <user> '<password>' >> deploy/.htpasswd
#
# then: docker compose exec web nginx -s reload
#
studio:$2y$05$REPLACE_WITH_A_REAL_BCRYPT_HASH_GENERATED_ON_THE_SERVER
